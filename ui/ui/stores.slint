// Data exchanged with Rust. Each screen has one global "store": Rust fills its properties
// and handles its callbacks. The data, questionnaire and matrix stores serve both methods;
// the profiles, local-priority, priorities and classification stores are AHPSort II only.

export struct DataColumn {
    name: string,
    unit: string,
}

export struct DataCell {
    text: string,
    valid: bool,
}

export struct DataRow {
    name: string,
    cells: [DataCell],
}

export struct QuizRow {
    left-name: string,
    left-detail: string,
    right-name: string,
    right-detail: string,
    // Dot of the Saaty scale (0..=16, 8 = equal).
    position: int,
    label: string,
    // 1: arrow points right (left dominates), -1: points left, 0: no arrow.
    direction: int,
}

export struct MatrixCell {
    text: string,
    editable: bool,
    valid: bool,
}

export struct MatrixCardData {
    title: string,
    subtitle: string,
    labels: [string],
    rows: [[MatrixCell]],
}

export struct MatrixStats {
    weights: [string],
    lambda-max: string,
    ci: string,
    cr: string,
    inconsistent: bool,
}

export struct RankItem {
    position: int,
    name: string,
    score: string,
    // Score relative to the first one (0..1), for the bar.
    share: float,
    // Visual scale of the item (1.5 for the first one, decreasing).
    scale: float,
}

// AHPSort II: a category column of the profiles table.
export struct ProfileColumn {
    name: string,
    // false for the last category in limiting mode (it has no profile).
    has-profile: bool,
}

// AHPSort II: a row of the profiles table (one per criterion).
export struct ProfileRow {
    name: string,
    unit: string,
    // One cell per category with a profile.
    cells: [DataCell],
}

// AHPSort II: maximum of the range [0 - max] of a criterion.
export struct RangeCell {
    text: string,
    valid: bool,
    // true: set by hand; false: follows the maximum of the criterion's values.
    manual: bool,
}

export struct LocalRow {
    label: string,
    x: string,
    y: string,
}

export struct ChartTick {
    // Position along the axis inside the plot box (logical pixels).
    pos: float,
    label: string,
}

// AHPSort II: local priorities of the range points of one criterion, with its chart.
export struct LocalTable {
    title: string,
    unit: string,
    rows: [LocalRow],
    plot-width: float,
    plot-height: float,
    // SVG path commands in plot-box coordinates.
    line: string,
    markers: string,
    x-ticks: [ChartTick],
    y-ticks: [ChartTick],
}

// A read-only row of a priorities table.
export struct ResultRow {
    name: string,
    cells: [string],
    total: string,
}

export struct ClassRow {
    name: string,
    global: string,
    profile-global: string,
    category: string,
    // Position of the category in the category list (colour of its tag); -1 if unknown.
    category-index: int,
}

// Shell: current screen, method, file and messages.
export global NavStore {
    // 0 start, 1 data, 2 questionnaires, 3 matrices, then 4 ranking (classic) or
    // 4 global priorities and 5 classification (AHPSort II).
    in property <int> screen: 0;
    in property <int> max-reached: 1;
    in property <bool> classic: true;
    // 0 eigenvalues, 1 geometric mean, 2 approximated.
    in property <int> weight-method: 0;
    in property <bool> has-project: false;
    in property <string> file-name;
    in property <string> message;
    in property <bool> message-is-error;
    callback go-to(int);
    callback back();
    callback next();
    callback save();
    callback new-problem();
    callback load-file();
    callback set-classic(bool);
    callback set-weight-method(int);
    callback dismiss-message();
}

export global DataStore {
    in property <[DataColumn]> columns;
    in property <[DataRow]> rows;
    in property <string> errors;
    in property <bool> can-jump-to-result;
    callback rename-criterion(int, string);
    callback set-unit(int, string);
    callback rename-alternative(int, string);
    // (alternative, criterion, text)
    callback set-value(int, int, string);
    callback add-criterion();
    callback remove-criterion(int);
    callback add-alternative();
    callback remove-alternative(int);
    callback jump-to-result();
}

export global QuizStore {
    in property <[string]> steps;
    in property <int> current;
    in property <string> title;
    in property <string> subtitle;
    in property <[QuizRow]> rows;
    // (question, position)
    callback select(int, int);
    callback go-to-group(int);
    callback previous-group();
    callback next-group();
    callback skip();
}

export global MatrixStore {
    in property <[MatrixCardData]> cards;
    in property <[MatrixStats]> stats;
    // (card, row, column, text)
    callback edit(int, int, int, string);
}

export global RankingStore {
    in property <[RankItem]> items;
}

// AHPSort II: categories, profile type, ranges and profiles (data screen).
export global ProfilesStore {
    in property <bool> limiting;
    in property <[ProfileColumn]> columns;
    in property <[ProfileRow]> rows;
    // One per criterion.
    in property <[RangeCell]> ranges;
    // Name of the category without profile (limiting mode).
    in property <string> catch-all;
    callback set-limiting(bool);
    callback rename-category(int, string);
    callback add-category();
    callback remove-category(int);
    // (criterion, text)
    callback set-range(int, string);
    callback set-range-auto(int);
    // (criterion, profile, text)
    callback set-profile(int, int, string);
}

// AHPSort II: local priority tables and charts ("Detalles prioridad local").
export global LocalStore {
    in property <[LocalTable]> tables;
    // Meaning of the profile labels (CP1 = ..., ...).
    in property <string> legend;
}

// AHPSort II: local and global priorities of the alternatives and the profiles.
export global PrioritiesStore {
    in property <[string]> criteria;
    in property <[ResultRow]> alternatives;
    in property <[ResultRow]> profiles;
}

// AHPSort II: final classification.
export global ClassificationStore {
    in property <[ClassRow]> rows;
}
