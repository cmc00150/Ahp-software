// Application shell: top bar (Atrás, file, Guardar), step header, message bar and the
// current screen.
import { Button, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NavStore, DataStore, QuizStore, MatrixStore, RankingStore, ProfilesStore, LocalStore, PrioritiesStore, ClassificationStore } from "stores.slint";
import { MessageBanner, StepHeader } from "components/common.slint";
import { StartPage } from "pages/start.slint";
import { DataPage } from "pages/data.slint";
import { QuizPage } from "pages/quiz.slint";
import { MatricesPage } from "pages/matrices.slint";
import { RankingPage } from "pages/ranking.slint";
import { PrioritiesPage } from "pages/priorities.slint";
import { ClassificationPage } from "pages/classification.slint";

export { NavStore, DataStore, QuizStore, MatrixStore, RankingStore, ProfilesStore, LocalStore, PrioritiesStore, ClassificationStore }

export component AppWindow inherits Window {
    title: NavStore.file-name == "" ? "AHP" : "AHP — " + NavStore.file-name;
    preferred-width: 1100px;
    preferred-height: 750px;
    min-width: 860px;
    min-height: 560px;
    background: Theme.background;
    default-font-size: Theme.font-body;

    // Starts with the system color scheme; the top-bar button switches it. The std widgets
    // follow `Palette.color-scheme`, the custom components follow `Theme.dark`.
    init => {
        Theme.dark = Palette.color-scheme == ColorScheme.dark;
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    VerticalLayout {
        // Top bar.
        Rectangle {
            height: 56px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 12px;
                if NavStore.screen > 0: Button {
                    text: "Atrás";
                    clicked => {
                        NavStore.back();
                    }
                }
                Text {
                    text: "AHP";
                    font-size: 20px;
                    font-weight: 800;
                    color: Theme.accent;
                    vertical-alignment: center;
                }
                Text {
                    text: (NavStore.classic ? "AHP clásico" : "AHPSort II") + (NavStore.file-name == "" ? "" : " · " + NavStore.file-name);
                    color: Theme.muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Button {
                    text: Theme.dark ? "Modo claro" : "Modo oscuro";
                    clicked => {
                        Theme.dark = !Theme.dark;
                        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
                    }
                }
                Button {
                    text: "Guardar";
                    enabled: NavStore.has-project;
                    clicked => {
                        NavStore.save();
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // Steps of the flow.
        if NavStore.screen > 0: Rectangle {
            height: 50px;
            background: Theme.surface-alt;
            StepHeader {
                y: (parent.height - self.preferred-height) / 2;
                height: self.preferred-height;
                width: parent.width;
                steps: NavStore.classic ? ["Datos", "Cuestionarios", "Matrices", "Ranking"] : ["Datos", "Cuestionarios", "Matrices", "Prioridades globales", "Clasificación"];
                current: NavStore.screen - 1;
                max-reached: NavStore.max-reached - 1;
                clicked(i) => {
                    NavStore.go-to(i + 1);
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        MessageBanner {
            text: NavStore.message;
            is-error: NavStore.message-is-error;
            dismissed => {
                NavStore.dismiss-message();
            }
        }

        Rectangle {
            vertical-stretch: 1;
            if NavStore.screen == 0: StartPage {
                width: parent.width;
                height: parent.height;
            }
            // Data, questionnaires and matrices serve both methods.
            if NavStore.screen == 1: DataPage {
                width: parent.width;
                height: parent.height;
            }
            if NavStore.screen == 2: QuizPage {
                width: parent.width;
                height: parent.height;
            }
            if NavStore.screen == 3: MatricesPage {
                width: parent.width;
                height: parent.height;
            }
            if NavStore.screen == 4 && NavStore.classic: RankingPage {
                width: parent.width;
                height: parent.height;
            }
            if NavStore.screen == 4 && !NavStore.classic: PrioritiesPage {
                width: parent.width;
                height: parent.height;
            }
            if NavStore.screen == 5 && !NavStore.classic: ClassificationPage {
                width: parent.width;
                height: parent.height;
            }
        }
    }
}
