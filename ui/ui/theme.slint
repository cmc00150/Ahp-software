// Visual constants shared by every screen.
export global Theme {
    out property <color> background: #f2f4f8;
    out property <color> surface: #ffffff;
    out property <color> surface-alt: #f6f8fb;
    out property <color> border: #dbe1ea;
    out property <color> text: #1e293b;
    out property <color> muted: #64748b;
    out property <color> accent: #2563eb;
    out property <color> accent-soft: #dbe7fd;
    out property <color> danger: #dc2626;
    out property <color> danger-soft: #fde8e8;
    out property <color> warning: #b45309;
    out property <color> warning-soft: #fef3c7;
    out property <color> success: #15803d;
    out property <length> radius: 10px;
    out property <length> font-small: 12px;
    out property <length> font-body: 14px;
    out property <length> font-h2: 16px;
    out property <length> font-title: 22px;
}
