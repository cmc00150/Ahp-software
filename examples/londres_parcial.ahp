# Fichero de proyecto AHPSort II (formato TOML), basado en la Tabla 3 del artículo.
#
# - `alternatives`: distritos (boroughs) a clasificar.
# - `[[criteria]]`: `name`, `unit`, `values` (uno por distrito), `range` (máximo del rango;
#   los puntos de referencia RP1..RP6 van de 0 a ese máximo) y `profiles` (un valor por
#   categoría con perfil, en el orden de `categories.names`).
# - `[categories]`: `profile_type` "central" (un perfil por categoría) o "limiting" (la
#   última categoría no tiene perfil) y `names`.
# - `[evaluations]` (opcional): comparaciones por pares en escala de Saaty con signo, en el
#   orden del cuestionario (0,1), (0,2), ..., (1,2), ... x >= 1: gana el de la izquierda;
#   x <= -1: gana el de la derecha; 1: iguales. Este fichero solo trae `criteria`; las
#   comparaciones de rangos (`[evaluations.ranges]`) las preguntará la interfaz.

method = "shortII"
alternatives = ["Barking", "Barnet", "Camden", "Hackney", "Richmond", "Westminster"]

[[criteria]]
name = "Crímenes"
unit = "delitos/1000 hab."
values = [95.0, 70.0, 150.0, 120.0, 40.0, 190.0]
range = 206.0
profiles = [20.0, 100.0, 160.0]

[[criteria]]
name = "Robo"
unit = "delitos"
values = [90000.0, 60000.0, 170000.0, 120000.0, 20000.0, 240000.0]
range = 254572.0
profiles = [5000.0, 95000.0, 180000.0]

[[criteria]]
name = "Relacionado con Vehículo"
unit = "delitos"
values = [18000.0, 15000.0, 22000.0, 20000.0, 8000.0, 30000.0]
range = 35127.0
profiles = [5000.0, 19000.0, 27000.0]

[[criteria]]
name = "Orden Público"
unit = "delitos"
values = [1500.0, 1000.0, 2400.0, 2000.0, 500.0, 3500.0]
range = 3824.0
profiles = [300.0, 1800.0, 2500.0]

[[criteria]]
name = "Drogas"
unit = "delitos"
values = [600.0, 450.0, 1000.0, 850.0, 200.0, 1500.0]
range = 1608.0
profiles = [300.0, 600.0, 900.0]

[categories]
profile_type = "central"
names = ["Alto", "Medio", "Bajo"]

[evaluations]
# Crímenes-Robo, Crímenes-Vehículo, Crímenes-Orden, Crímenes-Drogas, Robo-Vehículo,
# Robo-Orden, Robo-Drogas, Vehículo-Orden, Vehículo-Drogas, Orden-Drogas
criteria = [2, 3, 3, 4, 2, 2, 3, 1, 2, 2]
