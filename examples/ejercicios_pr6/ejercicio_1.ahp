# Ejercicio 1 - AHPSort II: criminalidad en las provincias andaluzas en 2017.
#
# - Datos: Tabla 1 (data/Andalucía.xls), número absoluto de hechos conocidos.
# - `range` y `profiles`: Tabla 3 (el formato solo guarda el máximo del rango; RP1..RP6 van de
#   0 a él, como en la Tabla 5).
# - Pesos de los criterios: Tabla 4 (triángulo superior; el inferior es el recíproco).
# - [evaluations.ranges]: matrices de comparación de los 9 puntos (6 RP + 3 CP) de cada
#   criterio, ajustadas en escala de Saaty para reproducir las prioridades locales de la
#   Tabla 6 (ver scripts/generar.py).

method = "sortII"
alternatives = ["Almería", "Cádiz", "Córdoba", "Granada", "Huelva", "Jaén", "Málaga", "Sevilla"]

[[criteria]]
name = "Crímenes"
unit = "delitos"
values = [23.0, 61.0, 20.0, 32.0, 8.0, 17.0, 58.0, 86.0]
range = 206.0
profiles = [20, 100, 160]

[[criteria]]
name = "Robo"
unit = "delitos"
values = [17284.0, 26571.0, 14508.0, 19139.0, 11222.0, 7548.0, 46137.0, 52849.0]
range = 254572.0
profiles = [5000, 95000, 180000]

[[criteria]]
name = "Relacionado con Vehículo"
unit = "delitos"
values = [2101.0, 3945.0, 1691.0, 2299.0, 1409.0, 718.0, 6377.0, 9662.0]
range = 35127.0
profiles = [5000, 19000, 27000]

[[criteria]]
name = "Orden Público"
unit = "delitos"
values = [387.0, 722.0, 219.0, 368.0, 156.0, 175.0, 830.0, 716.0]
range = 3824.0
profiles = [300, 1800, 2500]

[[criteria]]
name = "Drogas"
unit = "delitos"
values = [267.0, 818.0, 148.0, 622.0, 139.0, 129.0, 934.0, 415.0]
range = 1608.0
profiles = [300, 600, 900]

[categories]
profile_type = "central"
names = ["Alto", "Medio", "Bajo"]

[evaluations]
# Crímenes-Robo, Crímenes-Vehículo, Crímenes-Orden, Crímenes-Drogas, Robo-Vehículo,
# Robo-Orden, Robo-Drogas, Vehículo-Orden, Vehículo-Drogas, Orden-Drogas
criteria = [5, 3, 7, 3, 3, -2, -4, -5, -5, -5]

[evaluations.ranges]
# Puntos de cada criterio por valor descendente (orden del cuestionario).
# Menos delitos = mayor prioridad, así que casi siempre gana el punto de la derecha (x < 0).
# RP6, RP5, CP3, RP4, CP2, RP3, RP2, CP1, RP1
"Crímenes" = [1, 1, -2, -2, -6, -6, -9, -9, 1, 1, -2, -4, -5, -9, -9, 1, -2, -3, -4, -9, -9, -2, -3, -4, -9, -9, 1, -2, -5, -9, -2, -4, -6, -2, -3, 1]
# RP6, RP5, CP3, RP4, RP3, CP2, RP2, CP1, RP1
"Robo" = [1, -2, -2, -5, -4, -7, -8, -9, 1, -2, -2, -2, -3, -6, -9, -2, -2, -2, -4, -8, -9, -2, -2, -3, -6, -9, 1, -2, -4, -7, -2, -4, -4, -2, -2, 1]
# RP6, RP5, CP3, RP4, CP2, RP3, RP2, CP1, RP1
"Relacionado con Vehículo" = [1, 1, -2, -3, -4, -6, -8, -9, 1, 1, -2, -3, -5, -4, -9, 1, -2, -2, -2, -3, -9, 1, 1, -3, -3, -9, 1, -2, -2, -9, -2, -2, -9, 1, -7, -3]
# RP6, RP5, CP3, RP4, CP2, RP3, RP2, CP1, RP1
"Orden Público" = [1, -2, -2, -4, -6, -7, -7, -9, 1, -2, -2, -2, -5, -7, -9, -2, -2, -2, -4, -8, -9, 1, 1, -2, -4, -8, 1, -2, -5, -6, -3, -4, -4, -2, -2, 1]
# RP6, RP5, RP4, CP3, RP3, CP2, RP2, CP1, RP1
"Drogas" = [1, -3, -3, -4, -5, -9, -9, -9, 1, 1, -3, -4, -5, -9, -9, 1, -2, -3, -4, -7, -9, -2, -2, -3, -7, -9, 1, -2, -4, -9, -2, -5, -9, -3, -7, 1]
