# Ejercicio 4 - AHPSort II: criminalidad en las 50 provincias españolas en 2023 (sin
# Ceuta ni Melilla), en hechos conocidos por cada 10.000 habitantes, con la calibración
# de 2017 (ejercicio 3).
#
# - Datos: data/Datos_nacionales_2023_por_10000_ES.xlsx (tasas ya normalizadas),
#   redondeadas a 3 decimales.
# - `range` y `profiles`: los mismos del ejercicio 3 (calibrados en 2017).
# - Truncamiento: las tasas fuera de [RP1, RP6] = [0, range] se recortan al extremo.
#   Tasas truncadas (original -> truncada):
#   Orden Público - Araba/Álava: 6.861 -> 5.9
#   Orden Público - Alicante/Alacant: 8.327 -> 5.9
#   Orden Público - Almería: 8.608 -> 5.9
#   Orden Público - Illes Balears: 7.634 -> 5.9
#   Orden Público - Cádiz: 8.085 -> 5.9
#   Orden Público - Castellón/Castelló: 6.772 -> 5.9
#   Orden Público - Girona: 6.524 -> 5.9
#   Orden Público - Gipuzkoa: 7.17 -> 5.9
#   Orden Público - Madrid: 8.318 -> 5.9
#   Orden Público - Málaga: 7.856 -> 5.9
#   Orden Público - Murcia: 6.602 -> 5.9
#   Orden Público - Navarra: 8.024 -> 5.9
#   Orden Público - Soria: 7.599 -> 5.9
#   Orden Público - Tarragona: 6.253 -> 5.9
#   Orden Público - Toledo: 5.903 -> 5.9
#   Orden Público - Valencia/València: 7.48 -> 5.9
#   Orden Público - Zaragoza: 8.42 -> 5.9
#   Drogas - Granada: 12.664 -> 6.9
#   Drogas - Málaga: 7.131 -> 6.9
# - Pesos de los criterios de 2017. Las funciones locales también son las de 2017: copia
#   aquí el bloque `[evaluations.ranges]` que obtengas en el ejercicio 3; si no, la
#   interfaz preguntará las comparaciones de los puntos.

method = "sortII"
alternatives = ["Araba/Álava", "Albacete", "Alicante/Alacant", "Almería", "Ávila", "Badajoz", "Illes Balears", "Barcelona", "Burgos", "Cáceres", "Cádiz", "Castellón/Castelló", "Ciudad Real", "Córdoba", "A Coruña", "Cuenca", "Girona", "Granada", "Guadalajara", "Gipuzkoa", "Huelva", "Huesca", "Jaén", "León", "Lleida", "La Rioja", "Lugo", "Madrid", "Málaga", "Murcia", "Navarra", "Ourense", "Asturias", "Palencia", "Las Palmas", "Pontevedra", "Salamanca", "Santa Cruz de Tenerife", "Cantabria", "Segovia", "Sevilla", "Soria", "Tarragona", "Teruel", "Toledo", "Valencia/València", "Valladolid", "Bizkaia", "Zamora", "Zaragoza"]

[[criteria]]
name = "Crímenes"
unit = "delitos/10.000 hab."
values = [0.208, 0.31, 0.395, 0.491, 0.316, 0.226, 0.418, 0.37, 0.112, 0.155, 0.504, 0.381, 0.285, 0.31, 0.249, 0.304, 0.334, 0.419, 0.255, 0.357, 0.207, 0.308, 0.306, 0.313, 0.358, 0.465, 0.37, 0.3, 0.405, 0.515, 0.566, 0.099, 0.209, 0.254, 0.333, 0.286, 0.153, 0.367, 0.17, 0.064, 0.506, 0.447, 0.614, 0.074, 0.288, 0.376, 0.345, 0.147, 0.18, 0.399]
range = 0.74
