[evaluations]
# Pesos de los criterios (los mismos del ejemplo de Londres):
# Crímenes-Robo, Crímenes-Vehículo, Crímenes-Orden, Crímenes-Drogas, Robo-Vehículo,
# Robo-Orden, Robo-Drogas, Vehículo-Orden, Vehículo-Drogas, Orden-Drogas
criteria = [2, 3, 3, 4, 2, 2, 3, 1, 2, 2]
