# Ejercicio 3 - AHPSort II: criminalidad en las 50 provincias españolas en 2017 (sin
# Ceuta ni Melilla), en hechos conocidos por cada 10.000 habitantes.
#
# - Datos: data/Datos_nacionales_2017_por_10000_ES.xlsx (tasas ya normalizadas),
#   redondeadas a 3 decimales.
# - CPs y RPs calibrados con las 50 provincias: `range` = máximo nacional redondeado
#   hacia arriba (RP1..RP6 van de 0 a él); Alto = percentil 25, Medio = mediana y
#   Bajo = percentil 75.
# - Se reutilizan los pesos de los criterios; la interfaz preguntará las comparaciones de
#   los puntos de cada criterio (funciones de prioridad local).

method = "sortII"
alternatives = ["Araba/Álava", "Albacete", "Alicante/Alacant", "Almería", "Ávila", "Badajoz", "Illes Balears", "Barcelona", "Burgos", "Cáceres", "Cádiz", "Castellón/Castelló", "Ciudad Real", "Córdoba", "A Coruña", "Cuenca", "Girona", "Granada", "Guadalajara", "Gipuzkoa", "Huelva", "Huesca", "Jaén", "León", "Lleida", "La Rioja", "Lugo", "Madrid", "Málaga", "Murcia", "Navarra", "Ourense", "Asturias", "Palencia", "Las Palmas", "Pontevedra", "Salamanca", "Santa Cruz de Tenerife", "Cantabria", "Segovia", "Sevilla", "Soria", "Tarragona", "Teruel", "Toledo", "Valencia/València", "Valladolid", "Bizkaia", "Zamora", "Zaragoza"]

