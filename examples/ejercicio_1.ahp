# Ejercicio 1 - AHPSort II: criminalidad en las provincias andaluzas en 2017.
#
# - Datos: Tabla 1 (data/Andalucía.xls), número absoluto de hechos conocidos.
# - `range` y `profiles`: Tabla 3. El formato solo admite el máximo del rango
#   (RP1..RP6 van de 0 a él), así que se omite el mínimo de la Tabla 3.
# - Las comparaciones de los puntos de cada criterio no vienen: la interfaz las preguntará.

method = "sortII"
alternatives = ["Almería", "Cádiz", "Córdoba", "Granada", "Huelva", "Jaén", "Málaga", "Sevilla"]

[[criteria]]
name = "Crímenes"
unit = "delitos"
values = [23.0, 61.0, 20.0, 32.0, 8.0, 17.0, 58.0, 86.0]
range = 206.0
profiles = [20.0, 100.0, 160.0]

[[criteria]]
name = "Robo"
unit = "delitos"
values = [17284.0, 26571.0, 14508.0, 19139.0, 11222.0, 7548.0, 46137.0, 52849.0]
range = 254572.0
profiles = [5000.0, 95000.0, 180000.0]

[[criteria]]
name = "Relacionado con Vehículo"
unit = "delitos"
values = [2101.0, 3945.0, 1691.0, 2299.0, 1409.0, 718.0, 6377.0, 9662.0]
range = 35127.0
profiles = [5000.0, 19000.0, 27000.0]

[[criteria]]
name = "Orden Público"
unit = "delitos"
values = [387.0, 722.0, 219.0, 368.0, 156.0, 175.0, 830.0, 716.0]
range = 3824.0
profiles = [300.0, 1800.0, 2500.0]

[[criteria]]
name = "Drogas"
unit = "delitos"
values = [267.0, 818.0, 148.0, 622.0, 139.0, 129.0, 934.0, 415.0]
range = 1608.0
profiles = [300.0, 600.0, 900.0]

[categories]
profile_type = "central"
names = ["Alto", "Medio", "Bajo"]

[evaluations]
# Pesos de los criterios (los mismos del ejemplo de Londres):
# Crímenes-Robo, Crímenes-Vehículo, Crímenes-Orden, Crímenes-Drogas, Robo-Vehículo,
# Robo-Orden, Robo-Drogas, Vehículo-Orden, Vehículo-Drogas, Orden-Drogas
criteria = [2, 3, 3, 4, 2, 2, 3, 1, 2, 2]
